# Gabarit du .env de production (/opt/agora/.env, mode 600).
#
# Créé UNE fois par deploy/bootstrap-server.sh, qui remplit les secrets vides
# ci-dessous ; jamais régénéré par la CI (un nouveau JWT_SECRET invaliderait
# toutes les sessions et la clé de l'app). Copie de sauvegarde : le coffre
# ../.agora-secrets/supabase.env. Ce fichier-ci, versionné, ne contient AUCUN
# secret.

# --- Adresses publiques -------------------------------------------------------
SITE_URL=https://agora.heianenterprise.com
API_URL=https://api.agora.heianenterprise.com
# Gabarits d'e-mail lus par GoTrue (défaut : ${SITE_URL}/email).
# EMAIL_TEMPLATES_URL=
# Adresses de retour autorisées après une liaison OAuth (compte Discord),
# séparées par des virgules : l'app web et le lien profond Android.
ADDITIONAL_REDIRECT_URLS=https://agora.heianenterprise.com,app.agora://login-callback

# --- Générés par bootstrap-server.sh -------------------------------------------
POSTGRES_PASSWORD=
# 64 caractères. ANON_KEY et SERVICE_ROLE_KEY en sont signées : changer l'un
# impose de régénérer les deux et de reconstruire l'app.
JWT_SECRET=
# Clé publiable de l'app (rôle anon) : embarquée dans l'app, pas secrète,
# mais hors du dépôt.
ANON_KEY=
# Clé d'administration (rôle service_role) : contourne toute la RLS. Aucun
# service ne s'en sert ; elle ne sort jamais du serveur et du coffre.
SERVICE_ROLE_KEY=
REALTIME_SECRET_KEY_BASE=
# 16 caractères exactement.
REALTIME_DB_ENC_KEY=
AGORA_WORKER_PASSWORD=

# --- SMTP Brevo (clé SMTP du coffre, voir ../brevo-email-guide.md) -----------
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SENDER=no-reply@heianenterprise.com

# --- Facultatif -----------------------------------------------------------------
# CAPTCHA : seulement quand l'app enverra le jeton.
# CAPTCHA_ENABLED=true
# CAPTCHA_PROVIDER=turnstile
# CAPTCHA_SECRET=
# Connexion Google (identité seule) : client OAuth « Application Web » de
# Google Cloud, redirection ${API_URL}/auth/v1/callback. À activer AVANT
# d'ajouter « google » à la variable GitHub AGORA_SIGN_IN_PROVIDERS.
# GOOGLE_ENABLED=true
# GOOGLE_CLIENT_ID=
# GOOGLE_SECRET=
# Liaison du compte Discord (OAuth, identité seule) : Client ID et Secret de
# l'onglet OAuth2 du portail Discord ; redirection déclarée là-bas :
# ${API_URL}/auth/v1/callback.
# DISCORD_OAUTH_ENABLED=true
# DISCORD_OAUTH_CLIENT_ID=
# DISCORD_OAUTH_SECRET=
# Bot Discord (voir docs/discord-architecture.md) : clé publique et
# identifiant de l'application, jeton du bot (secret, coffre).
# DISCORD_PUBLIC_KEY=
# DISCORD_APPLICATION_ID=
# DISCORD_BOT_TOKEN=

# Assistants IA (serveur MCP, docs/mcp-architecture.md) : serveur OAuth de
# GoTrue. À allumer EN DERNIER, une fois les portes déployées, puis
# « docker compose up -d auth ».
# AGORA_OAUTH_SERVER=true

# --- Version déployée (mise à jour par la CI) ----------------------------------
AGORA_TAG=latest
