<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- La pile Supabase locale parle en HTTP (http://10.0.2.2:55321 depuis
         l'émulateur). Android bloque le trafic en clair depuis targetSdk 28 :
         on le rouvre ICI, dans la variante debug seulement, pour qu'un build
         de développement puisse joindre la pile locale. Le binaire publié,
         lui, n'en sait rien et reste en HTTPS strict. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
